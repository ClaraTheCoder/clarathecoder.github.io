    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Accent call to action; pill in Default, 2px in Blueprint, glass chip in Opal.",
      "html": "<button class=\"ds-btn ds-btn-primary\">Send me an email <svg class=\"ds-btn__arrow\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:var(--space-200);block-size:var(--space-700);padding-inline:var(--space-400);border:var(--button-border-width) solid transparent;border-radius:var(--button-radius);font-family:var(--button-font-family);font-weight:var(--button-font-weight);font-size:var(--font-size-200);letter-spacing:var(--button-letter-spacing);text-transform:var(--button-text-transform);line-height:1;cursor:pointer;transition:background-color var(--duration-fast) var(--ease-standard),transform var(--motion-feedback-duration) var(--motion-feedback-easing)}.ds-btn__arrow{transition:transform var(--motion-feedback-nudge-duration) var(--motion-feedback-nudge-easing)}.ds-btn:hover .ds-btn__arrow,.ds-btn:focus-visible .ds-btn__arrow{transform:translateX(var(--motion-feedback-nudge))}.ds-btn:active{transform:scale(var(--motion-feedback-press-scale))}.ds-btn:focus-visible{outline:var(--focus-ring-width) solid var(--color-border-strong);outline-offset:var(--focus-ring-offset)}.ds-btn-primary{background:var(--button-primary-bg);color:var(--button-primary-fg);border-color:var(--button-primary-border-color);box-shadow:var(--button-primary-shadow);backdrop-filter:var(--button-backdrop)}.ds-btn-primary:hover,.ds-btn-primary:focus-visible{background:var(--button-primary-bg-hover)}"
    },
