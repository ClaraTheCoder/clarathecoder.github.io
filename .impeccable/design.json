      "description": "Mode-independent light button for use over imagery and video.",
      "html": "<button class=\"ds-btn-fixed\">Play showreel</button>",
      "css": ".ds-btn-fixed{display:inline-flex;align-items:center;block-size:var(--space-700);padding-inline:var(--space-400);border:var(--button-border-width) solid var(--button-fixed-border-color);border-radius:var(--button-radius);font-family:var(--button-font-family);font-weight:var(--button-font-weight);font-size:var(--font-size-200);line-height:1;cursor:pointer;background:var(--button-fixed-bg);color:var(--button-fixed-fg);box-shadow:var(--button-fixed-shadow);backdrop-filter:var(--button-fixed-backdrop);transition:background-color var(--duration-fast) var(--ease-standard),transform var(--motion-feedback-duration) var(--motion-feedback-easing)}.ds-btn-fixed:hover,.ds-btn-fixed:focus-visible{background:var(--button-fixed-bg-hover)}.ds-btn-fixed:active{transform:scale(var(--motion-feedback-press-scale))}.ds-btn-fixed:focus-visible{outline:var(--focus-ring-width) solid var(--color-border-strong);outline-offset:var(--focus-ring-offset)}"
    },
