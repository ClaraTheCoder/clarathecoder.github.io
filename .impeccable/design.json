      "css": ".ds-nav{display:flex;gap:var(--space-100)}.ds-nav__item{display:inline-flex;align-items:center;block-size:var(--space-700);padding-inline:var(--space-400);border-radius:var(--button-radius);font-family:var(--button-font-family);font-weight:var(--button-font-weight);font-size:var(--font-size-200);color:var(--color-text);text-decoration:none;transition:background-color var(--duration-fast) var(--ease-standard)}.ds-nav__item:hover,.ds-nav__item:focus-visible,.ds-nav__item[aria-current=page]{background:var(--button-ghost-bg-hover)}.ds-nav__item:focus-visible{outline:var(--focus-ring-width) solid var(--color-border-strong);outline-offset:var(--focus-ring-offset)}"
    },
    {
      "name": "Radio Cards",
      "kind": "custom",
      "refersTo": "radio-card",
      "description": "Native radios as cards; the theme picker gives each card its own data-preset so it previews that world.",
      "html": "<div class=\"ds-cards\"><label class=\"ds-card is-on\"><span class=\"ds-card__head\"><span class=\"ds-card__radio\"></span><span class=\"ds-card__title\">Default</span></span><span class=\"ds-card__desc\">Good for reading</span></label><label class=\"ds-card\"><span class=\"ds-card__head\"><span class=\"ds-card__radio\"></span><span class=\"ds-card__title\">Opal</span></span><span class=\"ds-card__desc\">Oooh, shiny!</span></label></div>",
      "css": ".ds-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-300);--_ring:var(--color-border-strong)}.ds-card{display:flex;flex-direction:column;gap:var(--space-200);padding:var(--space-400);color:var(--color-text);background:var(--color-bg);border:var(--surface-border-width) solid var(--color-border);border-radius:var(--surface-radius);box-shadow:var(--color-surface-shadow);font-family:var(--text-body-font-family);cursor:pointer;outline:var(--focus-ring-width) solid transparent;outline-offset:var(--focus-ring-offset);transition:transform var(--motion-feedback-duration) var(--motion-feedback-easing)}.ds-card:hover{border-color:var(--color-border-strong)}.ds-card:active{transform:scale(var(--motion-feedback-press-scale))}.ds-card.is-on{outline-color:var(--_ring)}.ds-card__title{font-family:var(--text-heading-3-font-family);font-size:var(--text-heading-4-font-size);font-weight:var(--text-heading-3-font-weight);letter-spacing:var(--text-heading-3-letter-spacing);text-transform:var(--text-heading-3-text-transform);line-height:var(--font-line-height-tight)}.ds-card__desc{font-size:var(--text-body-sm-font-size);color:var(--color-text-muted)}.ds-card__head{display:flex;flex-direction:row-reverse;justify-content:space-between;align-items:start;gap:var(--space-200)}.ds-card__radio{flex:none;display:grid;place-items:center;inline-size:var(--space-500);block-size:var(--space-500);border:var(--space-50) solid var(--color-border-strong);border-radius:var(--radius-full)}.ds-card.is-on .ds-card__radio{background:var(--color-accent);border-color:var(--color-accent)}.ds-card.is-on .ds-card__radio::before{content:'';inline-size:var(--space-200);block-size:var(--space-200);border-radius:var(--radius-full);background:var(--color-text-on-color)}"
