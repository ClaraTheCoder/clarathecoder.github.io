      "description": "The dialog/panel surface: flat in Default, glowing in Blueprint, glass in Opal.",
      "html": "<div class=\"ds-surface\"><h3 class=\"ds-surface__title\">Pick a hat</h3><p class=\"ds-surface__body\">Switch between Default, Blueprint and Opal.</p></div>",
      "css": ".ds-surface{max-inline-size:var(--size-container-prose);padding:var(--space-600);color:var(--color-text);background:var(--dialog-bg);border:var(--surface-border-width) solid var(--dialog-border-color);border-radius:var(--surface-radius);box-shadow:var(--dialog-shadow);backdrop-filter:var(--dialog-backdrop)}.ds-surface__title{margin:0 0 var(--space-300);font-family:var(--text-heading-3-font-family);font-size:var(--text-heading-3-font-size);font-weight:var(--text-heading-3-font-weight);line-height:var(--text-heading-3-line-height);letter-spacing:var(--text-heading-3-letter-spacing);text-transform:var(--text-heading-3-text-transform, none)}.ds-surface__body{margin:0;font-family:var(--text-body-font-family);font-size:var(--text-body-font-size);line-height:var(--text-body-line-height);color:var(--color-text-muted)}"
    },
