{
  "button": {
    "radius": { "$value": "{radius.full}" },

    "border-width": { "$value": "1px" },

    "font-family": { "$value": "var(--text-body-font-family)" },
    "font-weight": { "$value": "{font.weight.semibold}" },
    "letter-spacing": { "$value": "normal" },
    "text-transform": { "$value": "none" },

    "backdrop": { "$value": "none" },

    "primary-bg": { "$value": "{color.accent}" },
    "primary-bg-hover": { "$value": "{color.accent-hover}" },
    "primary-fg": { "$value": "{color.text-on-color}" },
    "primary-shadow": { "$value": "none" },
    "primary-border-color": { "$value": "{color.transparent}" },

    "fixed-bg": { "$value": "{color.fixed}" },
    "fixed-bg-hover": { "$value": "{color.fixed-hover}" },
    "fixed-fg": { "$value": "{color.fixed-inverse}" },
    "fixed-shadow": { "$value": "none" },
    "fixed-border-color": { "$value": "{color.transparent}" },
    
    "ghost-bg-hover": { "$value": "{color.ghost}" }
  }
}
