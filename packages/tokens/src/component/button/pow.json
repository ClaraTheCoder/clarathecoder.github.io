{
  "button": {
    "font-family": { "$value": "var(--text-heading-6-font-family)" },
    "letter-spacing": { "$value": "var(--text-heading-6-letter-spacing)" },
    "text-transform": { "$value": "uppercase" },

    "border-width": { "$value": "2px" },

    "primary-fg": { "$value": "{color.text-on-color-fixed}" },
    "primary-shadow": { "$value": "{color.surface-shadow}" },
    "primary-border-color": { "$value": "{color.border-strong}" },

    "secondary-bg": { "$value": "{color.secondary-subtle}" },
    "secondary-bg-hover": { "$value": "{color.secondary-subtle-hover}" },
    "secondary-fg": { "$value": "{color.text}" },
    "secondary-shadow": { "$value": "{color.surface-shadow}" },
    "secondary-border-color": { "$value": "{color.border-strong}" },

    "tertiary-border-color": { "$value": "{color.border-strong}" }
  }
}
