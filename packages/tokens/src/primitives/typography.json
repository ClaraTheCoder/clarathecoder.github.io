{
  "font": {
    "size": {
      "$type": "dimension",
      "100": { "$value": "clamp(0.8125rem, 0.7917rem + 0.1042vw, 0.875rem)" },
      "150": { "$value": "clamp(0.875rem, 0.8333rem + 0.2083vw, 1rem)" },
      "200": { "$value": "clamp(1rem, 0.9583rem + 0.2083vw, 1.125rem)" },
      "300": { "$value": "clamp(1.125rem, 1.0833rem + 0.2083vw, 1.25rem)" },
      "400": { "$value": "clamp(1.25rem, 1.1667rem + 0.4167vw, 1.5rem)" },
      "500": { "$value": "clamp(1.5rem, 1.375rem + 0.625vw, 1.875rem)" },
      "600": { "$value": "clamp(1.8125rem, 1.625rem + 0.9375vw, 2.375rem)" },
      "700": { "$value": "clamp(2.125rem, 1.8333rem + 1.4583vw, 3rem)" },
      "800": { "$value": "clamp(2.5rem, 2rem + 2.5vw, 4rem)" },
      "900": { "$value": "clamp(3.5rem, 2.25rem + 4vw, 6rem)" },
      "1000": { "$value": "clamp(4.5rem, 2.5rem + 8vw, 9rem)" }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.05 },
      "heading": { "$value": 1.15 },
      "snug": { "$value": 1.3 },
      "body": { "$value": 1.55 },
      "reading": { "$value": 1.65 }
    },
    "weight": {
      "$type": "fontWeight",
      "light": { "$value": 300 },
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "tracking": {
      "$type": "dimension",
      "tight": { "$value": "-0.02em" },
      "snug": { "$value": "-0.01em" },
      "normal": { "$value": "0em" },
      "wide": { "$value": "0.04em" },
      "wider": { "$value": "0.08em" },
      "widest": { "$value": "0.18em" }
    },
    "family": {
      "$type": "fontFamily",
      "system-sans": {
        "$value": "system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
      },
      "system-mono": {
        "$value": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace"
      },
      "saira-condensed": { "$value": "'Saira Condensed', 'Arial Narrow', sans-serif" },
      "jetbrains-mono": {
        "$value": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace"
      },
      "bangers": { "$value": "'Bangers', 'Comic Sans MS', cursive" },
      "comic-neue": { "$value": "'Comic Neue', 'Comic Sans MS', cursive" }
    }
  }
}
