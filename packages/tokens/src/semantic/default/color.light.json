{
  "color": {
    "$type": "color",
    "bg": { "$value": "{color.lavender.50}" },
    "surface": { "$value": "{color.lavender.150}" },
    "surface-hover": { "$value": "{color.lavender.100}" },
    "surface-shadow": { "$value": "none" },
    "surface-shadow-tight": { "$value": "none" },
    "surface-backdrop": { "$value": "none" },
    "surface-border": { "$value": "{color.border}" },

    "text": { "$value": "{color.neutral.800}" },
    "text-muted": { "$value": "{color.neutral.700}" },
    "text-subtle": {
      "$value": "light-dark(color-mix(in oklab, {color.text} 70%, transparent), color-mix(in oklab, {color.text} 55%, transparent))"
    },
    "text-on-color": { "$value": "{color.neutral.50}" },
    "text-on-color-fixed": { "$value": "{color.neutral.50}" },

    "border": { "$value": "{color.neutral.300}" },
    "border-strong": { "$value": "{color.neutral.600}" },

    "accent": { "$value": "{color.lavender.800}" },
    "accent-hover": { "$value": "{color.lavender.900}" },
    "accent-subtle": { "$value": "{color.lavender.200}" },
    "accent-subtle-hover": { "$value": "{color.lavender.300}" },

    "fixed": { "$value": "{color.neutral.100}" },
    "fixed-hover": { "$value": "{color.neutral.50}" },
    "fixed-inverse": { "$value": "{color.neutral.900}" },
    "fixed-inverse-hover": { "$value": "{color.neutral.800}" },

    "success": { "$value": "{color.viridian.700}" },
    "success-hover": { "$value": "{color.viridian.800}" },
    "success-subtle": { "$value": "{color.viridian.100}" },
    "success-subtle-hover": { "$value": "{color.viridian.200}" },

    "danger": { "$value": "{color.vermilion.700}" },
    "danger-hover": { "$value": "{color.vermilion.800}" },
    "danger-subtle": { "$value": "{color.vermilion.100}" },
    "danger-subtle-hover": { "$value": "{color.vermilion.200}" },

    "warning": { "$value": "{color.lavender.600}" },
    "warning-hover": { "$value": "{color.lavender.700}" },
    "warning-subtle": { "$value": "{color.lavender.100}" },
    "warning-subtle-hover": { "$value": "{color.lavender.200}" },

    "info": { "$value": "{color.cerulean.700}" },
    "info-hover": { "$value": "{color.cerulean.800}" },
    "info-subtle": { "$value": "{color.cerulean.100}" },
    "info-subtle-hover": { "$value": "{color.cerulean.200}" },

    "overlay": { "$value": "{color.black-alpha.60}" },
    "ghost": { "$value": "{color.black-alpha.5}" },
    "transparent": { "$value": "{color.black-alpha.0}" }
  }
}
