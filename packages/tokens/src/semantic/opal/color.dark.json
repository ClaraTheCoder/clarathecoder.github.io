{
  "color": {
    "$type": "color",
    "surface": { "$value": "{color.white-alpha.10}" },
    "surface-hover": { "$value": "{color.white-alpha.20}" },
    "surface-shadow": { "$value": "0 22px 48px -24px rgba(12, 18, 40, 0.6), inset 0 1px 0 {color.white-alpha.60}" },
    "surface-shadow-tight": { "$value": "0 5px 10px -5px {color.black-alpha.60}, inset 0 1px 0 {color.white-alpha.60}" },
    "surface-backdrop": { "$value": "blur(30px) saturate(1.3)" },
    "surface-border": { "$value": "{color.white-alpha.30}" }
  }
}
