{
  "color": {
    "$type": "color",
    "surface": { "$value": "{color.black-alpha.20}" },
    "surface-hover": { "$value": "{color.black-alpha.40}" },
    "surface-shadow": { "$value": "0 22px 48px -24px rgba(12, 18, 40, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.8)" },
    "surface-backdrop": { "$value": "blur(30px) brightness(80%) saturate(1.3)" },
    "surface-border": { "$value": "{color.white-alpha.40}" }
  }
}
