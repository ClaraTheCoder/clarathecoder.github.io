---
import Base from '../../layouts/Base.astro';
import { Hero, Text, PostList, Post, Flex } from '@clara/design-system';
import { POSTS, formatDate, postsByYear } from '../../data/posts';
---

<Base>
  <div class="page">
    <Hero title="Writing">
      <Text variant="lead">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt
        ut labore et dolore magna aliqua.
      </Text>
    </Hero>

    <Flex direction="column" gap="800">
      {
        postsByYear(POSTS).map(([year, posts]) => (
          <PostList title={year}>
            {posts.map((post) => (
              <Post
                meta={`${formatDate(post.date, { year: false })} · ${post.readingTime} min read`}
                title={post.title}
                href={`/writing/${post.slug}`}
                description={post.description}
              />
            ))}
          </PostList>
        ))
      }
    </Flex>
  </div>
</Base>
