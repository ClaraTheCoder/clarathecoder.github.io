---
import Base from '../../layouts/Base.astro';
import { Text, Container, Grid, Box, Flex, Link, Icon, Video, Image, Alert, AlertTitle, AlertDescription, TableOfContents } from '@clara/design-system';
import { ALL_POSTS, POSTS, formatDate, type Post } from '../../data/posts';

export function getStaticPaths() {
  return ALL_POSTS.map((post) => {
    // Undated drafts aren't in POSTS, so they get no pager.
    const i = POSTS.findIndex((dated) => dated.slug === post.slug);
    return {
      params: { slug: post.slug },
      props: {
        post,
        newer: i === -1 ? null : (POSTS[i - 1] ?? null),
        older: i === -1 ? null : (POSTS[i + 1] ?? null),
      },
    };
  });
}

interface Props {
  post: Post;
  newer: Post | null;
  older: Post | null;
}

const { post, newer, older } = Astro.props;
---

<Base title={post.title} description={post.description}>
  <article class="page">
    <!-- Title + meta live in the left column; prose on the right -->
    <Grid className="entrance-stagger" columns={{ initial: 1, md: 12 }} gapX="var(--grid-gutter)" gapY="600">
      <Box className="article-rail" gridColumn={{ md: '1 / 5' }}>
        <Flex as="header" direction="column" gap="500">
          <Text variant="heading-2" as="h1" className="article-title">{post.title}</Text>
          <Flex align="center" wrap="wrap" gap="300">
            {post.date ? <time datetime={post.date}>{formatDate(post.date)}</time> : <span>Undated</span>}
          </Flex>
        </Flex>
        {post.toc && <TableOfContents entries={post.toc} className="article-toc" />}
      </Box>

      <Flex className="article-body" direction="column" gap="600" gridColumn={{ md: '5 / -1' }}>
        {
          post.draft && (
            <Alert variant="warning">
              <AlertTitle>Draft</AlertTitle>
              <AlertDescription>
                Only visible under <code>astro dev</code>. Remove <code>draft: true</code> from the frontmatter to
                publish. <Link href="/writing/drafts">All drafts</Link>
              </AlertDescription>
            </Alert>
          )
        }
        {
          post.video ? (
            <figure>
              <Video
                poster={post.video.poster}
                aria-label={post.video.label}
                track={{ src: post.video.captions, srcLang: 'en', label: 'English' }}
                transcriptHref={post.video.transcript}
              >
                {post.video.sources.map((source) => <source src={source.src} type="video/mp4" media={source.media} />)}
              </Video>
            </figure>
          ) : (
            post.image && (
              <Flex as="figure" direction="column" gap="400">
                <Image
                  src={post.image.src}
                  alt={post.image.alt}
                  width={post.image.width}
                  height={post.image.height}
                  ratio={post.image.ratio}
                  matte={post.image.matte}
                  p={post.image.p}
                />
                {post.image.caption && (
                  <figcaption>
                    {post.image.captionHref ? (
                      <Link href={post.image.captionHref}>{post.image.caption}</Link>
                    ) : (
                      post.image.caption
                    )}
                  </figcaption>
                )}
              </Flex>
            )
          )
        }
        <Container variant="prose" className="prose">
          <post.Content />
        </Container>
        {
          (older || newer) && (
            <nav class="article-pager" aria-label="More writing">
              {older && (
                <a class="article-pager__link article-pager__link--older" href={`/writing/${older.slug}`}>
                  <span class="article-pager__label">
                    <Icon name="arrow-left" /> Older
                  </span>
                  <span class="article-pager__title">{older.title}</span>
                </a>
              )}
              {newer && (
                <a class="article-pager__link article-pager__link--newer" href={`/writing/${newer.slug}`}>
                  <span class="article-pager__label">
                    Newer <Icon name="arrow-right" />
                  </span>
                  <span class="article-pager__title">{newer.title}</span>
                </a>
              )}
            </nav>
          )
        }
      </Flex>
    </Grid>
  </article>
</Base>
