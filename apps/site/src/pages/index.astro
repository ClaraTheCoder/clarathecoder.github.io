---
import Base from '../layouts/Base.astro';
import { Hero, Text, Link } from '@clara/design-system';
import { ThemeControl } from '../components/ThemeControl';
---

<Base>
  <div class="page">
    <Hero title="Hi, I'm Clara">
      <Text variant="lead">
        I like building things and helping people. At the moment I'm mostly working on
        <Link href="/work">design systems</Link>, tinkering with online tools and toys, making music, and <Link href="/writing">writing</Link> about it all.
      </Text>
      <Text variant="lead">
        <strong>I'm available for hire.</strong> Read about
        <Link href="/work">what I can do</Link>, or <Link href="#">say hi</Link>.
      </Text>
    </Hero>

    <ThemeControl client:only="react" />
  </div>
</Base>
