---
import Base from '../layouts/Base.astro';
import { Hero, Text, Link } from '@clara/design-system';
import { ThemeControl } from '../components/ThemeControl';
---

<Base>
  <div class="page">
    <Hero title="Hi, I’m Clara">
      <Text variant="lead">
        I like making things and helping people. At the moment I’m <Link href="/work">working</Link> on design systems and shipping products, tinkering with online tools and toys, growing food and making music.
        Sometimes I <Link href="/writing">write</Link> about those things.
      </Text>
      <Text variant="lead">
        <strong>I’m available for hire.</strong> Read about
        <Link href="/work">what I do</Link>, or <Link href="#">say hi</Link>.
      </Text>
    </Hero>

    <ThemeControl client:only="react" />
  </div>
</Base>
