---
import Base from '../layouts/Base.astro';
import { Hero, Text, Link, Testimonial, PostList, Post, RuledHeading, Disclosure, DisclosureList, Grid, Box, Flex, Video } from '@clara/design-system';
import unOchaLogo from '../assets/logos/un-ocha.svg?raw';
import adidasLogo from '../assets/logos/adidas.svg?raw';
import aggrekoLogo from '../assets/logos/aggreko.svg?raw';
import macmillanLogo from '../assets/logos/macmillan.svg?raw';
import butlinsLogo from '../assets/logos/butlins.svg?raw';
import dfdsLogo from '../assets/logos/dfds.svg?raw';
import { SITE } from '../data/site';
import { postsInSeries } from '../data/posts';

// Drafts drop out in production, so a case study may not be listed yet.
const caseStudies = postsInSeries('neo');

const principles = [
  {
    title: 'I think in systems.',
    body: 'Much of my work has involved making sense of big, complex digital systems, and looking for the small changes that give a system room to grow. Coding agents can build components faster than I can these days, but they still need someone who can keep the big picture in mind. People and processes are a vital part of any software system too.',
  },
  {
    title: 'I ask “why” a until it’s a bit annoying.',
    body: 'I’m curious about everything, and I’d rather solve a problem than just close a ticket. As much as I enjoy well-crafted code, I care more about the people using it than about writing the perfect abstraction. That makes me pretty good at translating between business, design and code, and my favourite days are when I build a tool that turns a month of boring work into an afternoon, or gives users what they need so they can maybe spend a little less time online.',
  },
  {
    title: 'I do good work in good company.',
    body: 'I love working with thoughtful, talented people. In more than a decade of coding professionally, it’s always been the best part of the job.',
  },
];

const waysToWork = [
  {
    title: 'Lay the foundations',
    body: 'Get started on a new design system, or give a wobbly one a proper base. I’ll make the engineering decisions, give you the core components, and document everything so your team can keep building on it long after I’ve left.',
  },
  {
    title: 'Make your system AI-ready',
    body: 'I’ll build tooling and documentation for coding agents, so your team can ship on-brand pages and burn fewer tokens doing it. If your design system already has agent tooling, I can benchmark how well different models use it and suggest improvements.',
  },
  {
    title: 'An extra pair of hands',
    body: 'Sometimes you just need another experienced engineer. I can lead the team or get stuck in, and I’m usually shipping by the end of the first week. I also love untangling the legacy code that nobody else wants to touch.',
  },
  {
    title: 'Talks, workshops and writing',
    body: 'Chatting with other nerds is great fun. If your team, meetup or conference would like a talk or a hands-on workshop on design systems or coding agents, get in touch.',
  },
];

const clients = [
  { name: 'UN OCHA', logo: unOchaLogo },
  { name: 'Adidas', logo: adidasLogo },
  { name: 'Aggreko', logo: aggrekoLogo },
  { name: 'Macmillan Cancer Support', logo: macmillanLogo },
  { name: 'Butlins', logo: butlinsLogo },
  { name: 'DFDS', logo: dfdsLogo },
];

const labelLogo = (svg: string, name: string) => {
  const [, , width, height] = svg.match(/viewBox="([^"]+)"/)![1].split(/\s+/).map(Number);
  const ratio = (width / height).toFixed(2);
  return svg.replace('<svg ', `<svg class="logo-wall__logo" role="img" aria-label="${name}" style="--logo-ratio: ${ratio}" `);
};
---

<Base title="Work">
  <div class="page page--roomy">
    <Hero title="Let’s work together">
      <Text variant="lead">
        I’m a creative engineer who’s spent 12 years building websites, apps and design systems. I work on a contract basis, and short projects of three to six months are where I often do my best work, but I’m open to longer contracts too.
      </Text>
      <Text variant="lead">
        I’m generally only interested in permanent roles if you’re a charity or a co-operative, or the work is exceptionally interesting and unusual. If you’ve got something in mind, <Link href={`mailto:${SITE.email}`}>send me an email</Link>.
      </Text>
    </Hero>

    <Flex as="section" aria-labelledby="how-i-work" direction="column" gap="600">
      <RuledHeading id="how-i-work">How I work</RuledHeading>
      <div class="prose">
        <Text variant="lead">
          I’ve been a tech lead, a design system engineer and a product engineer, and I’ve worked with clients of all sizes, from small local businesses to the United Nations. Before that I studied architecture, which is where I got my eye for good design. A few things have stayed true for me throughout my career:
        </Text>
      </div>
      <DisclosureList>
        {
          principles.map((principle) => (
            <Disclosure title={principle.title}>
              <Text>{principle.body}</Text>
            </Disclosure>
          ))
        }
      </DisclosureList>
    </Flex>

    <Grid as="section" className="entrance-stagger" aria-labelledby="case-study-title" columns={{ initial: 1, lg: 12 }} gapX="var(--grid-gutter)" gapY="500">
      <Box className="work-rail" gridColumn={{ lg: '1 / 5' }}>
        <Text variant="heading-2" as="h2" id="case-study-title">Case study: Vodafone’s first AI-native design system</Text>
      </Box>
      <Flex direction="column" gap="700" gridColumn={{ lg: '5 / -1' }}>
        <Video
          poster="/videos/neo-migration-promo-poster.jpg"
          aria-label="Migrating a page to Neo with one prompt"
          track={{ src: '/videos/neo-migration-promo.en.vtt', srcLang: 'en', label: 'English' }}
        >
          <source src="/videos/neo-migration-promo-1080.mp4" type="video/mp4" media="(min-width: 52rem)" />
          <source src="/videos/neo-migration-promo-720.mp4" type="video/mp4" />
        </Video>
        <div class="prose">
          <Text variant="lead">
            Neo is Vodafone’s new global design system, used by teams across the company on web and React Native. In 2026, I joined a small team of designers to architect the foundations, build the core components, and make it a system that coding agents can use to build a working, on-brand page with a single prompt.
          </Text>
        </div>
        {
          caseStudies.length > 0 && (
            <PostList>
              {caseStudies.map((post) => (
                <Post meta={`${post.readingTime} min read`} title={post.title} href={`/writing/${post.slug}`} description={post.description} />
              ))}
            </PostList>
          )
        }
      </Flex>
    </Grid>

    <Testimonial name="Ashton Snook" role="Head of Design & Research" company="Vodafone Group" wide>
      Despite working remotely, Clara has felt <strong>integral to the team from day one</strong>, bringing
      candour, positivity and <strong>genuine collaboration</strong> across design and engineering.
    </Testimonial>

    <Flex as="section" aria-labelledby="clients" direction="column" gap="900">
      <RuledHeading id="clients">Others I’ve worked with</RuledHeading>
      <Grid as="ul" className="logo-wall" columns={{ initial: 2, sm: 3, lg: 6 }} gap="var(--grid-gutter)">
        {
          clients.map(({ name, logo }, index) => (
            <li class="logo-wall__item" style={`--logo-index: ${index}`}>
              <Fragment set:html={labelLogo(logo, name)} />
            </li>
          ))
        }
      </Grid>
    </Flex>

    <Flex as="section" aria-labelledby="ways-to-work" direction="column" gap="600">
      <RuledHeading id="ways-to-work">What I do</RuledHeading>
      <Grid as="ul" className="work-cards" columns={{ initial: 1, sm: 2, xl: 4 }} gap="var(--grid-gutter)">
        {
          waysToWork.map((item) => (
            <Flex as="li" direction="column" gap="300">
              <Text variant="heading-5" as="h3">{item.title}</Text>
              <Text color="muted">{item.body}</Text>
            </Flex>
          ))
        }
      </Grid>
    </Flex>

    <Grid as="section" aria-labelledby="contact" columns={{ initial: 1, lg: 12 }} gapX="var(--grid-gutter)" gapY="500">
      <Box gridColumn={{ lg: '1 / 6' }}>
        <Text variant="display-2" as="h2" id="contact">Something else in mind?</Text>
      </Box>
      <Flex className="prose" direction="column" gap="400" gridColumn={{ lg: '6 / -1' }}>
        <Text variant="lead">
          Are you working on something strange? I like strange. <Link href={`mailto:${SITE.email}`}>Send me an email</Link>.
        </Text>
        <Text variant="lead">
          I’m based in South Yorkshire and mostly work remotely, with the occasional day in Sheffield, Leeds, Manchester or London.
        </Text>
      </Flex>
    </Grid>
  </div>
</Base>
