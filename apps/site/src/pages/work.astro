---
import Base from '../layouts/Base.astro';
import { Hero, Text, Link, Testimonial, PostList, Post, RuledHeading, Disclosure, DisclosureList, Grid, Box, Flex, Video } from '@clara/design-system';
import unOchaLogo from '../assets/logos/un-ocha.svg?raw';
import adidasLogo from '../assets/logos/adidas.svg?raw';
import aggrekoLogo from '../assets/logos/aggreko.svg?raw';
import macmillanLogo from '../assets/logos/macmillan.svg?raw';
import butlinsLogo from '../assets/logos/butlins.svg?raw';
import dfdsLogo from '../assets/logos/dfds.svg?raw';
import { SITE } from '../data/site';
import { POSTS, SHOW_WRITING } from '../data/posts';

const caseStudies = ['neo-foundations', 'neo-for-agents'].map((slug) => POSTS.find((post) => post.slug === slug)!);

const principles = [
  {
    title: 'Nothing is “not my problem.”',
    body: 'I’m curious about everything: the design, the business, the people who’ll actually use the thing. So I ask “but why?” more than is strictly polite, until the real problem falls out. I’d rather solve that than just close the ticket. It makes me pretty good at translating between business, design and code, and at remembering that people and processes are part of a software system too.',
  },
  {
    title: 'I judge my work by what it does for people.',
    body: 'I like tidy code as much as the next engineer, but I care more about helping people than building the perfect abstraction. My favourite days at work are when I delight designers with journeys that look exactly how they drew them, create tools that turn a month of boring work into an afternoon, and give users what they need so they can get on with living life (and maybe spend a little less time online). I’d rather make a system that people want to use than be the Design System Police.',
  },
  {
    title: 'I do good work in good company.',
    body: 'I love working with thoughtful, talented people. After more than a decade of coding professionally, it’s still the best part of the job.',
  },
];

const waysToWork = [
  {
    title: 'Lay the foundations',
    body: 'Get started on a new design system, or give a wobbly one a proper base. I’ll make the engineering decisions and build the foundation, and document everything so your team can keep building on it long after I’ve left.',
  },
  {
    title: 'Get your team AI-ready',
    body: 'I’ll make your design system legible to agents, so they reach for the right component instead of inventing their own. Then I’ll test it against real models, so your team ships on-brand pages faster and burns fewer tokens doing it.',
  },
  {
    title: 'An extra pair of hands',
    body: 'Sometimes you just need another experienced engineer. I’ll slot in as a tech lead or senior engineer and ship product with you. I’ll happily take on the legacy code nobody else wants to touch, fixing it up rather than starting again.',
  },
  {
    title: 'Talks, workshops and writing',
    body: 'I love talking about design systems, AI and the space where design meets engineering. If your team, meetup or conference would like a talk or a hands-on workshop on any of that, get in touch.',
  },
];

const clients = [
  { name: 'UN OCHA', logo: unOchaLogo },
  { name: 'Adidas', logo: adidasLogo },
  { name: 'Aggreko', logo: aggrekoLogo },
  { name: 'Macmillan Cancer Support', logo: macmillanLogo },
  { name: 'Butlins', logo: butlinsLogo },
  { name: 'DFDS', logo: dfdsLogo },
];

const labelLogo = (svg: string, name: string) => {
  const [, , width, height] = svg.match(/viewBox="([^"]+)"/)![1].split(/\s+/).map(Number);
  const ratio = (width / height).toFixed(2);
  return svg.replace('<svg ', `<svg class="logo-wall__logo" role="img" aria-label="${name}" style="--logo-ratio: ${ratio}" `);
};
---

<Base title="Work">
  <div class="page page--roomy">
    <Hero title="Let’s work together">
      <Text variant="lead">
        I’m a creative engineer who’s spent 12 years turning business requirements and design into working software. I usually work on a contract basis, and short projects of three to six months suit me nicely, but I’m open to longer engagements or a permanent role if the right one comes along. Read on, or <Link href={`mailto:${SITE.email}`}>drop me an email</Link> if you’ve got something in mind.
      </Text>
    </Hero>

    <Flex as="section" aria-labelledby="how-i-work" direction="column" gap="600">
      <RuledHeading id="how-i-work">How I work</RuledHeading>
      <Text variant="lead" className="how-i-work__intro">
        I’ve been a tech lead, a design system engineer and a product engineer. I started out in agencies, building everything from sites for small local businesses to campaigns for global brands, and more recently I’ve been embedded with product teams. Before any of that I studied architecture, and it left me with a lasting love of good design. Through everything, a few things have held true:
      </Text>
      <DisclosureList>
        {
          principles.map((principle) => (
            <Disclosure title={principle.title}>
              <Text>{principle.body}</Text>
            </Disclosure>
          ))
        }
      </DisclosureList>
    </Flex>

    <Grid as="section" className="entrance-stagger" aria-labelledby="case-study-title" columns={{ initial: 1, lg: 12 }} gapX="var(--grid-gutter)" gapY="500">
      <Box className="work-rail" gridColumn={{ lg: '1 / 5' }}>
        <Text variant="heading-2" as="h2" id="case-study-title">Case study: Vodafone’s first AI-native design system</Text>
      </Box>
      <Flex direction="column" gap="700" gridColumn={{ lg: '5 / -1' }}>
        <Video
          poster="/videos/neo-migration-promo-poster.jpg"
          aria-label="Migrating a page to Neo with one prompt"
          track={{ src: '/videos/neo-migration-promo.en.vtt', srcLang: 'en', label: 'English' }}
        >
          <source src="/videos/neo-migration-promo-1080.mp4" type="video/mp4" media="(min-width: 52rem)" />
          <source src="/videos/neo-migration-promo-720.mp4" type="video/mp4" />
        </Video>
        <Text as="div" className="prose">
          <p>
            Neo is Vodafone’s new global design system, used by teams across the company on web and React Native. In 2026, I joined a small team of designers to architect the foundations, build the core components, and make it a system that coding agents can use to build a working, on-brand page with a single prompt.
          </p>
        </Text>
        {
          SHOW_WRITING && (
            <PostList>
              {caseStudies.map((post) => (
                <Post meta={`${post.readingTime} min read`} title={post.title} href={`/writing/${post.slug}`} description={post.description} />
              ))}
            </PostList>
          )
        }
      </Flex>
    </Grid>

    <Testimonial name="Ashton Snook" role="Head of Design & Research" company="Vodafone Group" wide>
      Despite working remotely, Clara has felt <strong>integral to the team from day one</strong>, bringing
      candour, positivity and <strong>genuine collaboration</strong> across design and engineering.
    </Testimonial>

    <Flex as="section" aria-labelledby="clients" direction="column" gap="900">
      <RuledHeading id="clients">Others I’ve worked with</RuledHeading>
      <Grid as="ul" className="logo-wall" columns={{ initial: 2, sm: 3, lg: 6 }} gap="var(--grid-gutter)">
        {
          clients.map(({ name, logo }, index) => (
            <li class="logo-wall__item" style={`--logo-index: ${index}`}>
              <Fragment set:html={labelLogo(logo, name)} />
            </li>
          ))
        }
      </Grid>
    </Flex>

    <Flex as="section" aria-labelledby="ways-to-work" direction="column" gap="600">
      <RuledHeading id="ways-to-work">What I do</RuledHeading>
      <Grid as="ul" className="work-cards" columns={{ initial: 1, sm: 2, lg: 4 }} gap="var(--grid-gutter)">
        {
          waysToWork.map((item) => (
            <Flex as="li" direction="column" gap="300">
              <Text variant="heading-5" as="h3">{item.title}</Text>
              <Text color="muted">{item.body}</Text>
            </Flex>
          ))
        }
      </Grid>
    </Flex>

    <Grid as="section" aria-labelledby="contact" columns={{ initial: 1, lg: 12 }} gapX="var(--grid-gutter)" gapY="500">
      <Box gridColumn={{ lg: '1 / 7' }}>
        <Text variant="display-2" as="h2" id="contact">Drop me a line</Text>
      </Box>
      <Flex className="contact__body" direction="column" gap="400" gridColumn={{ lg: '7 / -1' }}>
        <Text variant="lead">
          If what you need doesn’t fit neatly into any of those, <Link href={`mailto:${SITE.email}`}>send me an email</Link> anyway, and tell me what you’re working on.
        </Text>
        <Text variant="lead">
          I’m based in South Yorkshire and mostly work remotely, with the occasional day in Sheffield, Leeds, Manchester or London.
        </Text>
      </Flex>
    </Grid>
  </div>
</Base>
