---
import { Video } from '@clara/design-system';
import showreel1080 from '../assets/showreel/showreel-2026-10-1080.mp4';
import showreel720 from '../assets/showreel/showreel-2026-10-720.mp4';
import showreelPoster from '../assets/showreel/showreel-2026-10-poster.webp';
import showreelCaptions from '../assets/showreel/showreel-2026-10.en.vtt?no-inline';
import { Content as ShowreelTranscript } from '../assets/showreel/showreel-2026-10-transcript.md';
import promo1080 from '../assets/promo/neo-migration-promo-1080.mp4';
import promo720 from '../assets/promo/neo-migration-promo-720.mp4';
import promoPoster from '../assets/promo/neo-migration-promo-poster.jpg';
import promoCaptions from '../assets/promo/neo-migration-promo.en.vtt?no-inline';

export type NeoVideoName = 'showreel' | 'migration';

interface Props {
  video: NeoVideoName;
}

const { video } = Astro.props;
---

{
  video === 'showreel' ? (
    <Video
      poster={showreelPoster.src}
      aria-label="Showreel: Vodafone Neo"
      track={{ src: showreelCaptions, srcLang: 'en', label: 'English' }}
    >
      <source src={showreel1080} type='video/mp4; codecs="avc1.640029, mp4a.40.2"' media="(min-width: 52rem)" />
      <source src={showreel720} type='video/mp4; codecs="avc1.640029, mp4a.40.2"' />
      <Fragment slot="transcript"><ShowreelTranscript /></Fragment>
    </Video>
  ) : (
    <Video
      poster={promoPoster.src}
      aria-label="Migrating a page to Neo with one prompt"
      track={{ src: promoCaptions, srcLang: 'en', label: 'English' }}
    >
      <source src={promo1080} type="video/mp4" media="(min-width: 52rem)" />
      <source src={promo720} type="video/mp4" />
    </Video>
  )
}
