---
import '@clara/tokens/tokens.css';
import '@clara/design-system/styles.css';
import '@clara/design-system/swirl.css';
import '@clara/design-system/grid-backdrop.css';
import '../styles/site.css';
import { Notice, SiteHeader, SiteFooter, Link } from '@clara/design-system';
import { ThemeDialog } from '../components/ThemeDialog';
import { AvailableFrom } from '../components/AvailableFrom';
import { fontPreloads } from '@clara/design-system/font-preloads.js';
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Clara Jordan',
  description = 'Design-systems engineer and tech lead.',
} = Astro.props;

const nav = [
  { label: 'Writing', href: '/writing' },
  { label: 'Work', href: '/work' },
];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline define:vars={{ fontPreloads }}>
      (function () {
        var KEY = 'theme-mode';
        var root = document.documentElement;
        var stored;
        try {
          stored = localStorage.getItem(KEY);
        } catch (e) {}
        var mode = ['raw','default','opal','blueprint'].includes(stored) ? stored : 'default';

        function apply(next) {
          root.dataset.themeMode = next;
          if (next === 'opal' || next === 'blueprint') root.setAttribute('data-preset', next);
          else root.removeAttribute('data-preset');
          // 'raw' strips all author CSS via [data-raw] (site.css); no stylesheet
          // juggling, so it survives navigation and dev's late style injection.
          if (next === 'raw') root.setAttribute('data-raw', '');
          else root.removeAttribute('data-raw');
          try {
            localStorage.setItem(KEY, next);
          } catch (e) {}
        }

        window.__setThemeMode = apply;
        apply(mode);

        (fontPreloads[mode] || []).forEach(function (href) {
          var link = document.createElement('link');
          link.rel = 'preload';
          link.as = 'font';
          link.type = 'font/woff2';
          link.crossOrigin = '';
          link.href = href;
          document.head.appendChild(link);
        });

        var SCHEME_KEY = 'color-scheme';
        var storedScheme;
        try {
          storedScheme = localStorage.getItem(SCHEME_KEY);
        } catch (e) {}
        var scheme = ['system','light','dark'].includes(storedScheme) ? storedScheme : 'system';

        function applyScheme(next) {
          if (next === 'light' || next === 'dark') root.setAttribute('data-theme', next);
          else root.removeAttribute('data-theme');
          try {
            localStorage.setItem(SCHEME_KEY, next);
          } catch (e) {}
        }

        window.__setColorScheme = applyScheme;
        applyScheme(scheme);
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <div class="grid-backdrop" aria-hidden="true"></div>
    <div class="swirl" aria-hidden="true">
      <div class="swirl__rotor">
        <div class="swirl__aurora"></div>
      </div>
    </div>

    <a class="skip-link" href="#main">Skip to content</a>
    <Notice href="/work">
      <AvailableFrom builtAt={Date.now()} client:load />
    </Notice>

    <SiteHeader brand={{ label: 'claras.place', href: '/' }} nav={nav} current={Astro.url.pathname}>
      <ThemeDialog slot="actions" variant="header" client:load />
    </SiteHeader>

    <main id="main" class="container">
      <slot />
    </main>

    <SiteFooter>
      <p>Find me elsewhere on <Link href={SITE.social.linkedin}>LinkedIn</Link> and <Link href={SITE.social.github}>GitHub</Link>.</p>
    </SiteFooter>

    <script>
      import '@clara/design-system/video-play-cover.js';
      import '../scripts/reveal';
    </script>
  </body>
</html>
