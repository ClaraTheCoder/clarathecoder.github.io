---
import '@clara/tokens/tokens.css';
import '@clara/design-system/styles.css';
import '@clara/design-system/swirl.css';
import '@clara/design-system/grid-backdrop.css';
import '../styles/site.css';
import { Notice, SiteHeader, SiteFooter, Link } from '@clara/design-system';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Clara',
  description = 'Design-systems engineer and tech lead.',
} = Astro.props;

const nav = [
  { label: 'Writing', href: '/writing' },
  { label: 'Work', href: '/work' },
];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        var KEY = 'theme-mode';
        var root = document.documentElement;
        var stored;
        try {
          stored = localStorage.getItem(KEY);
        } catch (e) {}
        var mode = ['raw','default','opal','blueprint'].includes(stored) ? stored : 'default';

        function apply(next) {
          root.dataset.themeMode = next;
          if (next === 'opal' || next === 'blueprint') root.setAttribute('data-preset', next);
          else root.removeAttribute('data-preset');
          // 'raw' strips all author CSS via [data-raw] (site.css); no stylesheet
          // juggling, so it survives navigation and dev's late style injection.
          if (next === 'raw') root.setAttribute('data-raw', '');
          else root.removeAttribute('data-raw');
          try {
            localStorage.setItem(KEY, next);
          } catch (e) {}
        }

        window.__setThemeMode = apply;
        apply(mode);
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <div class="grid-backdrop" aria-hidden="true"></div>
    <div class="swirl" aria-hidden="true">
      <div class="swirl__rotor">
        <div class="swirl__aurora"></div>
      </div>
    </div>

    <a class="skip-link" href="#main">Skip to content</a>
    <Notice>🚧 Under construction 🚧</Notice>

    <SiteHeader brand={{ label: 'Clara', href: '/' }} nav={nav} />

    <main id="main" class="container">
      <slot />
    </main>

    <SiteFooter>
      <p>Find me elsewhere on <Link href="https://www.linkedin.com/in/clarajordan1/">LinkedIn</Link> and <Link href="https://github.com/clarathecoder">GitHub</Link>.</p>
    </SiteFooter>

    <script>
      import '@clara/design-system/video-element.js';
    </script>
  </body>
</html>
